# Application Configuration
NODE_ENV=development
HOST=localhost
PORT=3000

# Frontend and Server URLs
CORS_ORIGIN=http://localhost:5173
SERVER_DOMAIN=http://localhost:3000
REDIRECT_URI=http://localhost:3000/auth/google/callback

# Rate Limiting
COMMON_RATE_LIMIT_MAX_REQUESTS=1000
COMMON_RATE_LIMIT_WINDOW_MS=1000

# Database

POSTGRES_DB=react_node_drizzle_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app_user:change_this_password@localhost:5432/react_node_drizzle_db

# Password Security
PASSWORD_SALT=replace_with_a_secure_salt

# JWT Authentication
JWT_SECRET=replace_with_a_secure_secret
JWT_REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_token_secret
JWT_ACCESS_TOKEN_SECRET=replace_with_a_secure_access_token_secret

# Session Security
SESSION_SECRET=replace_with_a_secure_session_secret
ENCRYPTION_KEY=replace_with_a_secure_encryption_key

# Email Configuration
NODE_MAILER_USER=your_email@example.com
NODE_MAILER_PASSWORD=your_email_app_password
GMAIL_USER=your_gmail@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback